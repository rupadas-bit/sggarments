# Server
PORT=3000

# ADMIN AUTHENTICATION CREDENTIALS
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# STORE CONFIGURATION (Sensitive / Business Contact Details)
# STORE_NAME: Store display name shown across the website
STORE_NAME="SG Fashion"
# STORE_WHATSAPP_NUMBER: The WhatsApp number to receive orders and enquiries (country code without '+' or spaces, e.g. 919876543210)
STORE_WHATSAPP_NUMBER="911234567890"

# STORE_PHONE: Display hotline telephone number
STORE_PHONE="+91 98765 43210"

# STORE_EMAIL: Official customer support email address
STORE_EMAIL="support@sggarments.com"

# STORE_ADDRESS: Physical store location address
STORE_ADDRESS="Commercial Hub, M.G. Road, Kolkata, West Bengal — 700007"

# STORE_HOURS: Store operating hours
STORE_HOURS="Mon – Sat: 10:00 AM – 8:30 PM | Sun: 11:00 AM – 6:00 PM"

# STORE_LOGO: Optional fallback logo image URL (can be changed from the admin panel)
# STORE_LOGO=""
# STORE_HERO_IMAGE: Optional fallback homepage hero image URL (can be changed from the admin panel)
# STORE_HERO_IMAGE=""

# CLOUDINARY (Image hosting for the logo, hero banner and product images)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# MONGO DB (Connection string for MongoDB Atlas — required for database storage)
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# ZOHO MAIL AUTOMATED ORDER NOTIFICATIONS
# ZOHO_MAIL_USER="support@sggarments.com"
# ZOHO_MAIL_PASS="your_zoho_app_password"
# ZOHO_SMTP_HOST="smtppro.zoho.in"
# ZOHO_SMTP_PORT="465"
# NOTIFICATION_EMAIL="support@sggarments.com"