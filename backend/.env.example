# ============================================================
# SG Fashion — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Add all of these in your Vercel backend project settings too.
# ============================================================

# ---- Admin Credentials ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# ---- Store Business Info (shown across website) ----
STORE_NAME=SG Fashion
STORE_WHATSAPP_NUMBER=919876543210
STORE_PHONE=+91 98765 43210
STORE_EMAIL=support@sggarments.com
STORE_ADDRESS=Commercial Hub, M.G. Road, Kolkata, West Bengal — 700007
STORE_HOURS=Mon – Sat: 10:00 AM – 8:30 PM | Sun: 11:00 AM – 6:00 PM

# ---- MongoDB Atlas (leave blank to use JSON file fallback) ----
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=sgfashion

# ---- Cloudinary (for image uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS: Frontend URL (your Vercel frontend domain) ----
# Example: https://sg-fashion.vercel.app
FRONTEND_URL=https://your-frontend-project.vercel.app

# ---- Zoho Mail Automated Order Notifications ----
# ZOHO_MAIL_USER: Your Zoho Mail address (e.g. support@sggarments.com or yourname@zoho.com)
ZOHO_MAIL_USER=support@sggarments.com
# ZOHO_MAIL_PASS: Your Zoho Account Password or Zoho App-Specific Password
ZOHO_MAIL_PASS=your_zoho_app_password
# ZOHO_SMTP_HOST: smtppro.zoho.in (for India domains) or smtp.zoho.com (for US/Global)
ZOHO_SMTP_HOST=smtppro.zoho.in
ZOHO_SMTP_PORT=465
# NOTIFICATION_EMAIL: Destination email address to receive order notifications (defaults to STORE_EMAIL)
NOTIFICATION_EMAIL=support@sggarments.com

